<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvMethodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingEnd="28dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="JazzCash Payment" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Detected SMS / payment info card -->
            <LinearLayout
                android:id="@+id/cardDetectedPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_light_purple"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_sms" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/label_detected_payment"
                        android:textColor="#1565C0"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="#DDD5F0" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_date_time" android:textColor="#757575" android:textSize="12sp" />
                    <TextView android:id="@+id/tvDetectedDateTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#424242" android:textStyle="bold" android:textSize="12sp" tools:text="Sat, 18 Jul — 4:32 PM" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_amount" android:textColor="#757575" android:textSize="12sp" />
                    <TextView android:id="@+id/tvDetectedAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#2E7D32" android:textSize="12sp" tools:text="Rs. 1500" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_sender_name" android:textColor="#757575" android:textSize="12sp" />
                    <TextView android:id="@+id/tvDetectedName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#424242" android:textStyle="bold" android:textSize="12sp" tools:text="Abbas Ali" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_sender_phone" android:textColor="#757575" android:textSize="12sp" />
                    <TextView android:id="@+id/tvDetectedPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#424242" android:textStyle="bold" android:textSize="12sp" tools:text="03xx-xxxxxxx" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/note_auto_detected"
                    android:textColor="#7A6FA8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Manual TID entry (most important, always required) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_transaction_id"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/note_transaction_id"
                android:textColor="#757575"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etTransactionId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_transaction_id"
                android:textColorHint="#757575"
                android:textColor="#212121"
                android:inputType="textCapCharacters"
                android:padding="14dp"
                android:textSize="15sp" />

            <!-- Bank Transfer fallback: sender's own TID from a different bank
                 never matches our receiving TID — sender name + amount + a
                 time window is used instead when TID matching fails. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_sender_name_optional"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/note_sender_name"
                android:textColor="#757575"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSenderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_sender_name"
                android:textColorHint="#757575"
                android:textColor="#212121"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:textSize="15sp" />

            <!-- Screenshot upload alternative -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E0E0E0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:text="@string/label_or" android:textColor="#9E9E9E" android:textSize="12sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E0E0E0" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUploadScreenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dashed"
                android:drawableStart="@drawable/ic_upload_cloud"
                android:drawablePadding="10dp"
                android:paddingVertical="12dp"
                android:text="@string/action_upload_screenshot_short"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/note_ocr_ai_fallback"
                android:textColor="#9E9E9E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvScreenshotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:gravity="center"
                android:padding="14dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="TID in screenshot does not match what you entered." />

            <Button
                android:id="@+id/btnVerifyAndActivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_verify"
                android:padding="14dp"
                android:text="@string/action_verify_activate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Processing / Success status area (hidden until submit) -->
            <LinearLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_light_green"
                android:orientation="vertical"
                android:padding="18dp"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_processing_title"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvStatusTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    tools:text="30:00" />

                <TextView
                    android:id="@+id/tvStatusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/status_processing_subtitle"
                    android:textColor="#5C6B5D"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>